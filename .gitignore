#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local build-time secrets (see env.example.json)
env.json

# Code generated by build_runner (freezed / json_serializable) — regenerate
# with: dart run build_runner build --delete-conflicting-outputs
*.freezed.dart
*.g.dart

# Firebase config (add your own once a project is created — see README)
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart
