		<string>NN Food &amp; Spices uses the camera to scan product barcodes and let you share photos.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>NN Food &amp; Spices needs photo library access so you can attach images (e.g. for reviews or support requests).</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>NN Food &amp; Spices uses the microphone for voice search.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>NN Food &amp; Spices uses speech recognition to power voice search.</string>
	</dict>
</plist>
